{
  "namespace": "hud",
  "hud_title_text/title_frame": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#hud_title_text_string",
            "binding_name_override": "#text",
            "binding_type": "global"
          },
          {
            "binding_type": "view",
            "source_property_name": "((not (#text = 'tf_demon_toten_pop_1')))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "hud_title_text/title_frame/title": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#hud_title_text_string",
            "binding_name_override": "#text",
            "binding_type": "global"
          },
          {
            "binding_type": "view",
            "source_property_name": "((not (#text = 'tf_demon_toten_pop_1')))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "tf_panel": {
    "type": "panel",
    "size": [
      "300%",
      "300%"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "tf_demon_toten_pop_1@hud.tf_title": {
          "$stay_duration": 1.8,
          "$fade_in_duration": 0,
          "$fade_out_duration": 0,
          "$texture": "textures/ui/totemforge/demon_toten_pop_1",
          "$flag": "tf_demon_toten_pop_1",
          "$size": [
            300,
            300
          ],
          "$offset": [
            0,
            0
          ],
          "$anchor_to": "center",
          "$anchor_from": "center",
          "$uv_size_re": [
            128,
            128
          ]
        }
      }
    ]
  },
  "tf_title": {
    "type": "image",
    "force_texture_reload": true,
    "layer": 31,
    "offset": "$offset",
    "size": "$size",
    "texture": "$texture",
    "anchor_from": "$anchor_from",
    "anchor_to": "$anchor_to",
    "alpha": 6,
    "anims": [
      "@hud.tf_wait_animation"
    ],
    "uv": "@hud.tf_aseprite_animation",
    "uv_size": "$uv_size_re",
    "$uv_size_re|default": [
      128,
      128
    ],
    "disable_anim_fast_forward": true,
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = $flag)",
        "target_property_name": "#visible"
      }
    ]
  },
  "tf_aseprite_animation": {
    "anim_type": "aseprite_flip_book",
    "initial_uv": [
      0,
      0
    ]
  },
  "tf_wait_animation": {
    "anim_type": "wait",
    "duration": "$stay_duration",
    "next": "@hud.tf_out_animation"
  },
  "tf_out_animation": {
    "anim_type": "alpha",
    "easing": "linear",
    "duration": 0,
    "from": 1,
    "to": 1,
    "destroy_at_end": "image_element"
  },
  "tf_totem_factory": {
    "type": "panel",
    "factory": {
      "name": "hud_title_text_factory",
      "control_ids": {
        "hud_title_text": "tf_panel@hud.tf_panel"
      }
    }
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "tf_totem_factory@hud.tf_totem_factory": {}
          }
        ]
      }
    ]
  }
}